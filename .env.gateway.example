# Merge into server/.env. Never commit actual keys.
# Same Redis URL and pool on every replica sharing the same provider quota.
AI_REDIS_URL=redis://llm-redis:6379/0
AI_LIMIT_POOL=interactive-llm-v1
# REQUIRED: exact Redis DB used by Spring JwtAuthFilter for logout blacklist.
AI_AUTH_REDIS_URL=redis://main-auth-redis:6379/0
# REQUIRED: same BASE64 encoded ACCESS secret used by Spring JwtUtil (HS512).
# At least 64 decoded bytes. Do NOT use the refresh-token secret.
AI_JWT_SECRET_BASE64=
AI_GLOBAL_RPM=54
AI_USER_RPM=30
AI_MODEL_CONCURRENCY=4
AI_LEASE_SECONDS=75
AI_DEADLINE_SECONDS=60
AI_MAX_ATTEMPTS=2
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
AI_GEMINI_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=qwen/qwen3-32b
AI_USAGE_RETENTION_DAYS=90
# Optional USD per million tokens. Unset => no fabricated cost estimate.
# AI_INPUT_USD_PER_MILLION=...
# AI_OUTPUT_USD_PER_MILLION=...
